/**
 * define the peer dependencies for your environment.
 * these components would be resolved once for all components in
 * in the dependency graph of your component.
 **/
{
  "policy": {
    "peers": [
      {
        "name": "react",
        /**
         * specific version used for development.
         **/
        "version": "^18.0.0",

        /**
         * range used for the component peer dependencies.
         **/
        "supportedRange": "^18.0.0"
      },
      {
        "name": "@teambit/community.ui.bit-cli.commands-provider",
        "version": "0.0.51",
        "supportedRange": "^0.0.51"
      },
      {
        "name": "@teambit/base-react.navigation.link",
        "version": "^2.0.29",
        "supportedRange": "^2.0.29"
      },
      {
        "name": "@types/node",
        "version": "~12.20.4",
        "supportedRange": "~12.20.4"
      },
      {
        "name": "react-dom",
        "version": "^18.0.0",
        "supportedRange": "^18.0.0"
      },
      {
        "name": "react-router-dom",
        "version": "^6.0.0",
        "supportedRange": "^6.0.0"
      },
      {
        "name": "graphql",
        "version": "15.8.0",
        "supportedRange": "^15.8.0"
      },
      {
        "name": "@mdx-js/react",
        "version": "1.6.22",
        "supportedRange": "^1.6.22"
      },
      {
        "name": "@teambit/mdx.ui.mdx-scope-context",
        "version": "0.0.496",
        "supportedRange": "^0.0.496"
      },
      {
        "name": "@apollo/client",
        "version": "^3.6.9",
        "supportedRange": "^3.6.9"
      },
      {
        "name": "subscriptions-transport-ws",
        "version": "^0.11.0",
        "supportedRange": "^0.11.0"
      }
    ],
    /**
     * dev dependencies resolved in the workspace
     * for components using this env. these dependencies would not be defined
     * as a direct component dependencies. they are used for component development only.
     **/
    "dev": [
      {
        "name": "@types/react",
        "version": "^18.2.12",
        "force": true
      },
      {
        "name": "@types/react-dom",
        "version": "^18.2.5",
        "force": true
      },
      {
        "name": "@types/jest",
        "version": "^29.2.2",
        "force": true
      },
      {
        "name": "@testing-library/react",
        "version": "^13.4.0",
        "force": true
      },
      {
        "name": "@types/testing-library__jest-dom",
        "version": "5.9.5",
        "force": true
      },
      {
        "name": "@testing-library/react-hooks",
        "version": "^8.0.0"
      }
    ],
    "runtime": []
  },

  /**
   * used to define patterns to different
   * files in your component and associate them with
   * bit aspects.
   **/
  "patterns": {
    "compositions": ["**/*.composition.*", "**/*.preview.*"],
    "docs": ["**/*.docs.*"],
    "tests": ["**/*.spec.*", "**/*.test.*"]
  }
}
